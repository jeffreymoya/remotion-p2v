{
  "name": "remotion-p2v",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "build": "remotion render",
    "typecheck": "tsc --noEmit",
    "smoke:deepseek": "tsx --env-file=.env scripts/deepseek-smoke.ts",
    "smoke:deepseek-brainstorm": "tsx --env-file=.env scripts/deepseek-brainstorm-smoke.ts",
    "test:pause-injector": "tsx tests/shared/tts-pause-injector.test.ts",
    "test:tts-chunking": "tsx tests/tts/tts-google-chunking.test.ts",
    "test:docu-stacked-bar": "tsx tests/docu/stacked-bar-layout.test.ts",
    "test:docu-article-text": "tsx tests/docu/article-text-layout.test.ts",
    "test:docu-youtube-pipeline": "tsx tests/docu/youtube-pipeline.test.ts",
    "quotas": "tsx --env-file=.env scripts/check-quotas.ts",
    "docu": "npx tsx --env-file=.env scripts/docu.ts",
    "docu:audition": "npx tsx --env-file=.env scripts/docu.ts --audition",
    "youtube-spike": "npx tsx --env-file=.env scripts/youtube-spike.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.457",
    "@remotion/google-fonts": "4.0.457",
    "@remotion/noise": "^4.0.457",
    "@remotion/paths": "^4.0.457",
    "@remotion/transitions": "^4.0.457",
    "@remotion/zod-types": "^4.0.457",
    "culori": "^4.0.2",
    "exa-js": "^2.13.0",
    "fastest-levenshtein": "^1.0.16",
    "langsmith": "^0.6.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "4.0.457",
    "remotion-bits": "^0.2.0",
    "roughjs": "^4.6.6",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.0.0",
    "canvas": "^3.2.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
