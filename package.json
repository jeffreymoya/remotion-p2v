{
  "name": "template-ai-video",
  "version": "1.0.0",
  "description": "Create AI videos using remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src app remotion --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "lint:ci": "npm run lint && npm run typecheck",
    "preview": "bash scripts/quick-preview.sh",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:check": "prisma migrate status",
    "test": "npm run test:vitest",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test:vitest:coverage": "vitest run --coverage",
    "test:vitest:ui": "vitest --ui",
    "test:fixtures": "tsx scripts/generate-test-fixtures.ts",
    "test:e2e": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' playwright test",
    "test:e2e:ui": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' playwright test --ui",
    "test:e2e:debug": "PWDEBUG=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' playwright test --headed",
    "check:api-keys": "bash tests/scripts/check-api-keys.sh",
    "prompt-optimizer": "tsx scripts/prompt-optimizer/index.ts",
    "prompt-to-video": "tsx scripts/prompt-to-video.ts",
    "po:default": "npm run prompt-optimizer -- --variations 5 --loops 3",
    "po:default:no-synthesize": "npm run prompt-optimizer -- --variations 5 --loops 3 --no-synthesize",
    "po:empirical": "npm run prompt-optimizer -- --variations 5 --loops 3 --empirical",
    "web:dev": "next dev",
    "web:build": "next build",
    "web:start": "next start",
    "web:lint": "next lint",
    "db:generate:storyflow": "sh -c 'DATABASE_URL=${STORYFLOW_DATABASE_URL:-file:./prisma/storyflow.db} prisma generate --schema prisma/storyflow.schema.prisma'",
    "db:push:storyflow": "sh -c 'DATABASE_URL=${STORYFLOW_DATABASE_URL:-file:./prisma/storyflow.db} prisma db push --schema prisma/storyflow.schema.prisma'"
  },
  "repository": {},
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/media": "^4.0.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.2",
    "axios": "^1.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.3.2",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "pino": "^10.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "^4.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@google-cloud/text-to-speech": "^5.6.0",
    "@playwright/test": "^1.58.1",
    "@remotion/eslint-config-flat": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/string-similarity": "^4.0.2",
    "@types/uuid": "^11.0.0",
    "@types/web": "0.0.166",
    "@types/yargs": "^17.0.33",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.2.3",
    "eslint": "9.19.0",
    "fs-extra": "^11.2.0",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.0",
    "prettier": "3.6.0",
    "prisma": "^6.8.0",
    "string-similarity": "^4.0.4",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "typescript": "5.8.2",
    "uuid": "^13.0.0",
    "vitest": "^4.0.18"
  },
  "private": true
}
