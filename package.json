{
  "name": "remotion-p2v",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "remotion studio",
    "build": "remotion render",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "smoke:deepseek": "tsx --env-file=.env scripts/deepseek-smoke.ts",
    "smoke:deepseek-brainstorm": "tsx --env-file=.env scripts/deepseek-brainstorm-smoke.ts",
    "test:pause-injector": "tsx tests/shared/tts-pause-injector.test.ts",
    "test:tts-chunking": "tsx tests/tts/tts-google-chunking.test.ts",
    "test:docu-article-text": "tsx tests/docu/article-text-layout.test.ts",
    "test:docu-youtube-pipeline": "tsx tests/docu/youtube-pipeline.test.ts",
    "test:docu-publish-manifest": "tsx tests/docu/publish-manifest.test.ts",
    "test:docu-channel-audit": "tsx tests/docu/channel-audit.test.ts",
    "test:docu-export-description": "tsx tests/docu/description-export.test.ts",
    "test:docu-ai-disclosure": "tsx tests/docu/ai-disclosure.test.ts",
    "test:docu-metadata-gate": "tsx tests/docu/metadata-gate.test.ts",
    "quotas": "tsx --env-file=.env scripts/check-quotas.ts",
    "docu": "npx tsx --env-file=.env scripts/docu.ts",
    "docu:audition": "npx tsx --env-file=.env scripts/docu.ts --audition",
    "docu:channel-audit": "npx tsx scripts/docu-channel-audit.ts",
    "docu:export-description": "npx tsx scripts/docu-export-description.ts",
    "docu:ai-disclosure": "npx tsx scripts/docu-ai-disclosure.ts",
    "docu:metadata-gate": "npx tsx scripts/docu-metadata-gate.ts",
    "youtube-spike": "npx tsx --env-file=.env scripts/youtube-spike.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.457",
    "@remotion/google-fonts": "4.0.457",
    "@remotion/noise": "^4.0.457",
    "@remotion/paths": "^4.0.457",
    "@remotion/transitions": "^4.0.457",
    "@remotion/zod-types": "^4.0.457",
    "culori": "^4.0.2",
    "exa-js": "^2.13.0",
    "fastest-levenshtein": "^1.0.16",
    "langsmith": "^0.6.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "4.0.457",
    "remotion-bits": "^0.2.0",
    "roughjs": "^4.6.6",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.0.0",
    "canvas": "^3.2.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
