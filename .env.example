# ─────────────────────────────────────────────────────────────────────────
# remotion-p2v environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# Values are read by `tsx --env-file=.env` (see package.json scripts).
# ─────────────────────────────────────────────────────────────────────────

# ── Required: LLM (narration, overlays, metric extraction) ───────────────
DEEPSEEK_API_KEY=

# ── Required: Google Cloud (Chirp 3 HD TTS + Vision screener) ────────────
GOOGLE_CLOUD_API_KEY=

# ── Required: stock imagery ──────────────────────────────────────────────
PEXELS_API_KEY=

# ── Required: research phase (need at least one of EXA / SERPER) ─────────
EXA_API_KEY=
SERPER_API_KEY=

# ── Optional: TTS provider selection ("google" | "elevenlabs") ──────────
# TTS_PROVIDER=google
# DOCU_TTS_VOICE=en-US-Chirp3-HD-Charon
# GOOGLE_TTS_VOICE_NAME=en-US-Chirp3-HD-Algieba

# ── Optional: ElevenLabs (only when TTS_PROVIDER=elevenlabs) ─────────────
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Optional: legacy stock video (shared inspire clients) ───────────────
# PIXABAY_API_KEY=

# ── Optional: YouTube clip path (--allow-youtube-clips) ─────────────────
# YOUTUBE_API_KEY=

# ── Optional: LangSmith tracing ──────────────────────────────────────────
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=remotion-p2v
# LANGSMITH_TRACING=true

# ── Optional: timeout overrides (milliseconds) ──────────────────────────
# GOOGLE_VISION_TIMEOUT_MS=15000
# ELEVENLABS_TIMEOUT_MS=60000
# SEARCH_TIMEOUT_MS=20000
# RESEARCH_BRAINSTORM_TIMEOUT_MS=600000
