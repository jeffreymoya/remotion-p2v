# StoryFlow web app
DATABASE_URL="file:./prisma/storyflow.db" # Prisma 7 requires DATABASE_URL; set to SQLite for StoryFlow
STORYFLOW_DATABASE_URL="file:./prisma/storyflow.db" # Required: StoryFlow database connection
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TTS (Required)
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# AI Models (Optional - defaults provided)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# GEMINI_PRO_MODEL=gemini-2.5-pro
# GEMINI_PRO_FALLBACK_MODEL=gemini-2.5-pro

# Development (Optional)
# SKIP_ENV_VALIDATION=true # Set to skip environment validation (not recommended)
